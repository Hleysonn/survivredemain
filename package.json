{
  "name": "survivredemain",
  "private": true,
  "version": "1.0.0",
  "description": "Application de survie et préparation aux catastrophes",
  "scripts": {
    "dev:front": "vite",
    "build:front": "vue-tsc -b && vite build",
    "preview:front": "vite preview",
    "dev:back": "nodemon --exec ts-node src/server/index.ts",
    "build:back": "tsc",
    "start:back": "node dist/server/index.js",
    "init-db": "ts-node src/server/scripts/initDB.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "leaflet": "^1.9.4",
    "mongoose": "^7.0.3",
    "morgan": "^1.10.0",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/leaflet": "^1.9.17",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.7",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4"
  }
}
